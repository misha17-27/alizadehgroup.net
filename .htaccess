# Alizadeh Group — Apache / LiteSpeed config (cPanel)
DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # never serve code, data or dev files directly
    RewriteRule ^(app|storage|\.git)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(md|yml|yaml|json|lock|sql|sqlite|log|dist)$ - [F,L]

    # the old WordPress site is gone: its files, feeds and spam archives answer 410 Gone
    RewriteRule ^(wp-admin|wp-content|wp-includes|category|tag|author|feed|comments/feed)(/|$) - [G]
    RewriteRule ^(wp-[a-z-]+|xmlrpc)\.php$ - [G]

    # PHP runs only through the site's own entry points; any other .php file is refused
    RewriteCond $1 !^(index|install|admin/index)$
    RewriteRule ^(.*?)\.(php[0-9]?|phtml|phar|pht)(/|$) - [F,NC]

    # existing files and folders (assets, uploads, admin/, install.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # everything else → front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
